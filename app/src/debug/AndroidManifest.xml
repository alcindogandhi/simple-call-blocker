<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application>
        <!-- Só no build de debug. A permissão DUMP restringe o envio ao adb shell. -->
        <receiver
            android:name=".debug.DebugCommandReceiver"
            android:exported="true"
            android:permission="android.permission.DUMP">
            <intent-filter>
                <action android:name="com.simplecallblocker.debug.ADD_RULE" />
                <action android:name="com.simplecallblocker.debug.SET" />
            </intent-filter>
        </receiver>
    </application>

</manifest>
